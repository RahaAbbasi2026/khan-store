{
  "name": "khan-store-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate --schema=./prisma/schema.prisma && tsc -p tsconfig.json",
    "test:payment": "npm run build && node --test test/payment-security.test.cjs",
    "test:security": "npm run build && node --test test/payment-security.test.cjs test/order-access.test.cjs test/cart-ownership.test.cjs test/jwt-security.test.cjs test/security-database.test.cjs test/migration-workflow.test.cjs test/seo-fields.test.cjs",
    "start": "node dist/src/main.js",
    "start:dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "start:prod": "node dist/src/main.js",
    "db:deploy": "prisma migrate deploy",
    "db:baseline": "node scripts/baseline.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "^5.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "express": "^5.2.1",
    "@types/node": "^20.11.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "prisma": "^5.10.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-socket": "0.2.14"
  },
  "engines": { "node": ">=20.9.0" }
}
